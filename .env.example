# Optional. When set, address search/geocoding (src/lib/geocode.ts) and
# live-map road routing (src/lib/routing.ts) prefer Google's Geocoding API
# and Directions API instead of the free OpenStreetMap Nominatim/OSRM
# fallback. Leave blank to keep using the free OSM stack — everything still
# works without a key.
#
# To get a key: console.cloud.google.com -> create/select a project -> APIs
# & Services -> enable "Geocoding API" and "Directions API" -> Credentials ->
# create an API key. Google requires billing enabled on the project even to
# stay within the free monthly usage tier. Restrict the key to those two
# APIs and to your dev/prod origins before using it anywhere but locally.
#
# Copy this file to .env.local (gitignored by default in Vite projects) and
# fill in the value — never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Shared backend (Supabase). Leave both blank and the app keeps every device's
# data in its own browser — fine for a demo on one phone, useless for a pilot
# where a passenger and a driver are on different phones and have to see each
# other's bookings.
#
# To set it up:
#   1. supabase.com -> New project (free tier is enough for a pilot).
#   2. SQL Editor -> paste supabase/migrations/0002_app_schema.sql -> Run.
#      Run 0002, NOT 0001 — 0001 is an old design draft that does not match
#      this app.
#   3. Project Settings -> API -> copy "Project URL" and the "anon public" key
#      into .env.local (copy this file to .env.local first).
#
# The anon key is meant to be public — it ships in the browser bundle by
# design. What protects the data is Row Level Security, and the pilot policies
# in 0002 are deliberately wide open. Read the comment in that file before
# putting the app anywhere public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Maya (PayMaya) payment gateway.
#
# MAYA_SECRET_KEY is a server-only credential: it can create, capture, void and
# refund payments on the merchant account. It is read ONLY by
# netlify/functions/maya-checkout.mjs and maya-status.mjs, never by anything
# under src/ — Vite compiles src/ into files every visitor downloads, so a
# secret key placed there is readable by anyone who opens the bundle.
#
# Set these in the Netlify UI (Site configuration -> Environment variables),
# not in a file that could be committed.
#
# MAYA_API_BASE defaults to the sandbox. Point it at https://pg.paymaya.com
# only when you are ready for real charges.
MAYA_SECRET_KEY=
MAYA_API_BASE=https://pg-sandbox.paymaya.com
# Comma-separated origins the passenger may be returned to after paying. Only
# these are accepted, so a caller cannot turn the payment flow into an open
# redirect. The first is used when the caller asks for one not on the list.
MAYA_RETURN_ORIGINS=https://todaridemobility.com,http://localhost:5199

# ---------------------------------------------------------------------------
# SMS: one-time codes and emergency alerts. Server-only, like the Maya key —
# nothing under src/ reads these, because src/ ships to every visitor.
#
# Set them in the Netlify UI (Site configuration -> Environment variables) and
# redeploy. Without them netlify/functions/send-otp.mjs answers every signup
# with 503 "OTP sending is not configured on the server yet", which on a phone
# looks like an app that is simply broken. The function log now names the
# variable that is missing — look there first.
#
# Locally it is server/.env that matters, not this file: `npm run server`
# keeps its codes in memory and needs only the Semaphore key. The signing
# secret exists because a Netlify Function is a fresh process per request and
# cannot remember what it sent.

# Any long random string, and the same one on send and verify. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates codes already in flight — harmless, they expire in
# five minutes.
OTP_SIGNING_SECRET=

# semaphore.co -> Dashboard -> API key. Every provider path falls back to
# Semaphore, so this is the key that decides whether sending works at all.
# Check the account still has credits: an empty balance fails exactly like a
# missing key, but only in the function log.
SEMAPHORE_API_KEY=
# Optional. A sender name registered with Semaphore; unset means their shared
# default. An unregistered name is rejected, so leave it blank if unsure.
SEMAPHORE_SENDER_NAME=
# Optional, 'true' sends SOS (not OTP) through Semaphore's priority route:
# 2 credits instead of 1, not rate limited.
SEMAPHORE_SOS_PRIORITY=

# Optional, and idle until somebody sets them — see netlify/functions/lib/
# sms.mjs. SMS_PROVIDER picks who carries one-time codes, SOS_SMS_PROVIDER
# who carries emergency alerts (left on Semaphore deliberately: an emergency
# is no place to debut an untested provider). SMS_FALLBACK_PROVIDER is tried
# only when the first never accepted the message.
# One of: semaphore, philsms, unisms
SMS_PROVIDER=
SOS_SMS_PROVIDER=
SMS_FALLBACK_PROVIDER=
PHILSMS_API_KEY=
PHILSMS_SENDER_ID=
UNISMS_API_KEY=
UNISMS_SENDER_ID=
