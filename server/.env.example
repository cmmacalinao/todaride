PORT=4000
# Shared by two features: login OTP codes (send-otp) and, once Super Admin
# turns the channel on, the one-tap "Send SMS" button on the safety desk
# (send-sos-sms). Same account, same credit balance for both.
SEMAPHORE_API_KEY=
# Must be a sender name registered and approved on the Semaphore account.
# An unregistered name is rejected with "senderName is not valid"; leaving this
# blank falls back to Semaphore's own default sender.
SEMAPHORE_SENDER_NAME=TodaRide

# ── Other SMS providers (see docs/SMS_PROVIDERS.md) ────────────────────────
# Leave every one of these unset during the pilot. Unset means Semaphore,
# behaving exactly as it does today.
#
# Who carries login codes: semaphore | philsms | unisms
SMS_PROVIDER=
# Tried once if the primary clearly fails. Leave blank for no fallback.
SMS_FALLBACK_PROVIDER=
# Emergency alerts have their own setting and their own default (semaphore).
# Move this only after codes have run on the new provider long enough to
# trust it — an SOS is not where you debut a provider.
SOS_SMS_PROVIDER=
# 'true' sends SOS through Semaphore's priority route: not rate limited,
# 2 credits instead of 1.
SEMAPHORE_SOS_PRIORITY=

# PhilSMS — https://app.philsms.com/developers/documentation
# The API token from Settings > API in the PhilSMS dashboard.
PHILSMS_API_KEY=
# A sender ID registered and approved on the PhilSMS account, max 11 chars.
# An unregistered one is rejected, the same way Semaphore rejects an
# unregistered sender name.
PHILSMS_SENDER_ID=

# UniSMS — https://unismsapi.com/docs/sms
# The SECRET key (used as the Basic-auth username, empty password).
UNISMS_API_KEY=
UNISMS_SENDER_ID=
