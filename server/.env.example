PORT=4000
# Shared by two features: login OTP codes (send-otp) and, once Super Admin
# turns the channel on, the one-tap "Send SMS" button on the safety desk
# (send-sos-sms). Same account, same credit balance for both.
SEMAPHORE_API_KEY=
# Must be a sender name registered and approved on the Semaphore account.
# An unregistered name is rejected with "senderName is not valid"; leaving this
# blank falls back to Semaphore's own default sender.
SEMAPHORE_SENDER_NAME=TodaRide
